# 环境变量配置文件示例
# 复制此文件为 .env 并填入真实的API密钥

# OpenAI API密钥（用于LLM和图片生成）
OPENAI_API_KEY=your_openai_api_key_here

# Stability AI密钥（用于图片生成）
STABILITY_API_KEY=your_stability_api_key_here

# 其他API密钥
WENXIN_ACCESS_TOKEN=your_wenxin_access_token_here
TONGYI_API_KEY=your_tongyi_api_key_here
PIKA_API_KEY=your_pika_api_key_here
RUNWAY_API_KEY=your_runway_api_key_here
